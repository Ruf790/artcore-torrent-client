+        painter.drawText(QRectF(r.left() + 62, r.top(), r.width() - 70, r.height()), Qt.AlignLeft | Qt.AlignVCenter,
+                         QFontMetrics(f).elidedText(str(index.data(Qt.DisplayRole) or ""), Qt.ElideRight, r.width() - 74))
+        painter.restore()
